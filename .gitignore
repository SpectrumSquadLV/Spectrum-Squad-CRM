# Installed locally to run and test the server; Railway installs its own from
# package.json during the Docker build.
node_modules/

# Generated by the local `npm install` used to run the test suites, which pulls
# dev-only packages (playwright, pg). The Dockerfile runs `npm install
# --omit=dev` from package.json, so shipping this lockfile would only risk
# changing what production resolves.
package-lock.json

# Local scratch
data/
*.log
.DS_Store

# Per-suite output from run-tests.js
test-logs/
