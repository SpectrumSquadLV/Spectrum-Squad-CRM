# ---------------------------------------------------------------------------
# Divine Feminine Academy - environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Postgres (Supabase gives you this connection string)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase - the anon key is safe in the browser, the service role key is NOT
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Journal encryption master key.
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every journal entry permanently unreadable. That is by
# design. Back it up somewhere you trust and nowhere else.
JOURNAL_MASTER_KEY=""

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Card details never reach this server: checkout hands off to Stripe's hosted
# page and the webhook tells us what happened.
STRIPE_SECRET_KEY=""
# From the Stripe dashboard, for the /api/webhooks/payments endpoint. Without
# it every webhook is rejected - which is correct: an unverified webhook is an
# anonymous request claiming somebody paid.
STRIPE_WEBHOOK_SECRET=""

# "stripe" (default) or "fake". The fake provider approves every payment and is
# REFUSED in production; it exists so checkout can be tested offline.
PAYMENTS_PROVIDER="stripe"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
