# ---------------------------------------------------------------------------
# Divine Feminine Academy - environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Postgres (Supabase gives you this connection string)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase - the anon key is safe in the browser, the service role key is NOT
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Journal encryption master key.
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every journal entry permanently unreadable. That is by
# design. Back it up somewhere you trust and nowhere else.
JOURNAL_MASTER_KEY=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
